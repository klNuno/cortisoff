{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cortisoff",
  "mainBinaryName": "cortisoff-dashboard",
  "version": "0.0.0",
  "identifier": "dev.cortisoff.dashboard",
  "build": {
    "beforeDevCommand": "pnpm sidecars && pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm sidecars --release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "The cortisoff dashboard",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/cortisoffd",
      "binaries/cortisoff"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEM0I1NTMyQUMzQTg4NkUKUldSdWlEcXNNbFU3amZ2ZGw3NUpLSnRCbkd1NDZqeVAyQXB4cHBTM3JjZkZmd1NiKzB0elhKNGsK",
      "endpoints": [
        "https://github.com/klNuno/cortisoff/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
